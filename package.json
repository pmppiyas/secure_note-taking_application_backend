{
  "name": "backend",
  "version": "1.0.0",
  "description": "Secure Note-Taking Application REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node-dev --transpile-only src/seed.ts",
    "seed:notes": "ts-node-dev --transpile-only src/scripts/seedAliceNotes.ts",
    "seed:posts": "ts-node-dev --transpile-only src/scripts/seedTechPosts.ts",
    "seed:all": "ts-node-dev --transpile-only src/scripts/seedAllPosts.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
